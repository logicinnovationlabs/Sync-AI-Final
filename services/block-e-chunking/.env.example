# Block E - Chunking and Embedding Pipeline Configuration

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/block_e

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CANONICAL=ingest.canonical.v1
KAFKA_TOPIC_CHUNKS=ingest.chunks.v1
KAFKA_TOPIC_DELETIONS=ingest.chunks.deletions.v1

# Embedding Configuration
# Architecture §6.2 assumes Azure OpenAI. Gemini is an interim Phase 2 deviation.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_DIMENSION=768
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_TOKENS=8191
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MAX_BATCH_SIZE=50

# Azure OpenAI (production target — preferred when credentials available)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_KEY=

# Chunking Configuration
CHUNKER_VERSION=1.0.0
PROSE_MAX_TOKENS=512
PROSE_OVERLAP_TOKENS=50

# Block A JWT validation (RS256 public key — required for Phase 2 Integration)
JWT_PUBLIC_KEY_PATH=../../backend/keys/public.pem
JWT_ISSUER=snyq-platform
JWT_ALGORITHM=RS256
# Optional HTTP validate endpoint if Block A adds one:
# BLOCK_A_TOKEN_VALIDATE_URL=http://localhost:8000/auth/validate

# Shared fixtures (Block Z v2)
FIXTURES_PATH=../../fixtures

# Throughput tuning (Phase 2)
E2_DOC_CONCURRENCY=4
E2_BATCH_SIZE=50

# Tenant Isolation
ENFORCE_TENANT_ISOLATION=true
