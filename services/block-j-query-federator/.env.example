ENVIRONMENT=test
ACL_BACKEND=memory
RERANKER_BACKEND=mock
EMBEDDING_BACKEND=mock
EMBEDDING_DIMENSIONS=64
EMBEDDING_MODEL_VERSION=text-embedding-3-large

LEXICAL_SEARCH_URL=http://localhost:8086
VECTOR_SEARCH_URL=http://localhost:8087
GRAPH_SERVICE_URL=http://localhost:8088

BACKEND_TIMEOUT_SECONDS=0.4
BACKEND_CONNECT_TIMEOUT_SECONDS=0.1
BACKEND_MAX_RETRIES=1

LEXICAL_WEIGHT=0.40
VECTOR_WEIGHT=0.40
GRAPH_WEIGHT=0.20
RERANK_TOP_K=100
RERANKER_ENABLED=true
# RERANKER_BACKEND=cross_encoder
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5439/block_j
ENFORCE_TENANT_ISOLATION=true
SERVICE_PORT=8089
ENABLE_PROMETHEUS_METRICS=true
LOG_LEVEL=INFO
