FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (libmagic, tesseract OCR, build tools)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libmagic1 \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt requirements-dev.txt ./

# Install Python dependencies (replace python-magic-bin with python-magic for Linux)
RUN pip install --upgrade pip && \
    sed -i 's/python-magic-bin==0.4.14/python-magic==0.4.27/' requirements.txt && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dev.txt

# Install pytest-timeout for robustness
RUN pip install --no-cache-dir pytest-timeout

# Copy application code, migrations, configs, scripts, and tests
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./
COPY scripts ./scripts
COPY keys ./keys
COPY tests ./tests
COPY pyproject.toml ./

# Set environment variables defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    JWT_PRIVATE_KEY_PATH=/app/keys/private.pem \
    JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

CMD ["pytest", "tests/", "-v", "--tb=short", "-p", "no:cacheprovider"]
