# ============================================================
# SynQ / Glean-like platform — backend environment template
# Copy to backend/.env and fill values. .env is gitignored.
# Single source of truth for runtime configuration.
# ============================================================

# --- Tenancy & Identity (Block A) ---
TENANT_METADATA_SERVICE_URL=http://localhost:8000
OAUTH_ISSUER_URL=https://mock-issuer.example.com
SCIM_SYNC_ENDPOINT=http://localhost:9999/scim
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=snyq-platform
JWT_ACTIVE_KID=key-2026-08
SESSION_STORE_REDIS_URL=redis://localhost:6379
# Legacy alias (still accepted):
REDIS_URL=redis://localhost:6379

# OIDC client (optional until SSO is wired)
OIDC_ISSUER=https://mock-issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# SCIM (legacy alias SCIM_ENDPOINT also accepted)
SCIM_ENDPOINT=http://localhost:9999/scim
SCIM_TOKEN=

# --- Storage substrate (Block D) ---
DB_HOST=localhost
DB_NAME=control_plane
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full URL (overrides assembly from DB_* when set)
CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/control_plane
# Cloud Supabase (optional; never log this value)
# Render has no IPv6. Do NOT use db.<ref>.supabase.co (direct) on Render — it
# fails with OSError 101 Network is unreachable. Use Session pooler instead:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
SUPABASE_POOLER_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MinIO / S3-compatible object store (local: docker-compose.deps or block-d-verify-minio)
OBJECT_STORE_CONNECTION_STRING=endpoint=http://localhost:9000;accessKey=minioadmin;secretKey=minioadmin;useSSL=false;bucket=glean-data
# Optional: upload tenant backups to object store (local dir always used as well)
BACKUP_BUCKET=
BACKUP_LOCAL_DIR=.backups

# KMS / Vault
KMS_KEY_VAULT_URL=
# Leave VAULT_URL empty for MockVaultClient (Azure Key Vault). Use KMS_KEY_VAULT_URL for HashiCorp.
KMS_KEY_NAME=my-encryption-key
VAULT_URL=
# Leave VAULT_URL empty for MockVaultClient (Azure Key Vault). Use KMS_KEY_VAULT_URL for HashiCorp.
VAULT_SECRET_PATH=secret/connectors
VAULT_TENANT_ID=
VAULT_CLIENT_ID=
VAULT_CLIENT_SECRET=

# --- Connectors & ingestion (Block B) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_RAW=ingest-raw
KAFKA_TOPIC_CANONICAL=ingest-canonical
CONNECTOR_RATE_LIMIT_PER_SOURCE=drive=100,slack=50,github=200

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/callback
# Optional: seed TokenStore for real-source local verification (7-day Testing-app tokens)
GOOGLE_REFRESH_TOKEN=
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-watch-notifications
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Microsoft Graph
# Outlook uses MICROSOFT_* below. SharePoint delegated OAuth uses MICROSOFT_SHAREPOINT_*.
# Do not point SharePoint at the Outlook client or redirect URI.
# Azure Portal → SynQ-SharePoint-Connector:
#   Redirect URI (Web): http://localhost:8000/connectors/sharepoint/callback
# Delegated: User.Read, Sites.Read.All, Files.Read.All, offline_access
# GroupMember.Read.All is not on the live delegated app; group grants fail closed.
# Outlook / generic Microsoft (do not reuse for SharePoint)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/outlook/callback

# SharePoint delegated OAuth (SynQ-SharePoint-Connector — distinct from Outlook)
# Redirect URI (Web): http://localhost:8000/connectors/sharepoint/callback
# Delegated: User.Read, Sites.Read.All, Files.Read.All, offline_access
# GroupMember.Read.All is not on this app; group grants fail closed.
# Personal OAuth authorize/token uses login.microsoftonline.com/common (any
# work or personal Microsoft account). MICROSOFT_SHAREPOINT_TENANT_ID is not
# used for that URL. Azure app "Supported account types" must be
# AzureADandPersonalMicrosoftAccount or Gmail/MSA still gets AADSTS50020.
MICROSOFT_SHAREPOINT_CLIENT_ID=
MICROSOFT_SHAREPOINT_TENANT_ID=
MICROSOFT_SHAREPOINT_CLIENT_SECRET=
MICROSOFT_SHAREPOINT_REDIRECT_URI=http://localhost:8000/connectors/sharepoint/callback

# Required for POST /admin/tenants (header X-SnyQ-Setup-Token)
TENANT_BOOTSTRAP_TOKEN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Watch Channel Renewal (hours)
WATCH_RENEWAL_CHECK_HOURS=24
WATCH_RENEWAL_BEFORE_EXPIRY_HOURS=48

# --- Search & indexing (Blocks F & G) ---
LEXICAL_SEARCH_URL=http://localhost:9200
VECTOR_SEARCH_URL=http://localhost:6333
VECTOR_INDEX_NAME=documents
# Legacy aliases:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# --- LLM & Assistant (Block L) ---
LLM_PROVIDER=fake
MODEL_VERSION=text-embedding-3-small
# Legacy aliases:
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
# Must match Qdrant collection size. Phase 1 used full Gemini 3072-d vectors.
# Never leave Gemini at 3072 while Qdrant is 384 — that silently truncates vectors.
EMBEDDING_DIMENSION=3072
EMBEDDING_DIMENSIONS=3072
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
GEMINI_API_KEY=
OPENROUTER_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-72b-instruct
# Chat LLM switch (independent of LLM_PROVIDER, which is embeddings fake/gemini).
# Use `openrouter` to call Qwen via OpenRouter. Requires OPENROUTER_API_KEY.
# `fake` is offline/tests only — never contacts Qwen.
LLM_CHAT_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOOL_CALL_ROUNDS=2
# Phase 1 defaults
LLM_CHAT_TEMPERATURE=0.3
LLM_CHAT_MAX_TOKENS=1500
# When true, chat final events include retrieved chunk metadata (server-only; never honor a client flag).
ASSISTANT_DEBUG=false
# Fernet / AES key for encrypting connector refresh tokens at rest (never commit real value)
TOKEN_ENCRYPTION_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability (Block O) ---
OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO
METRICS_NAMESPACE=glean_platform

# --- Runtime ---
ENVIRONMENT=development
# Comma-separated browser origins (production/staging). FRONTEND_URL is merged automatically.
# All *.vercel.app hosts are allowed via regex for preview + prod deployments.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:3000
# Per-IP+tenant fixed-window limit; 0 disables. /health and /ready are exempt.
RATE_LIMIT_PER_MINUTE=120
TOKEN_TTL_ACCESS=3600
TOKEN_TTL_REFRESH=604800
TENANT_CACHE_TTL_SECONDS=1800

# ============================================================
# BLOCK C: NORMALIZATION, IDENTITY, AND ACL CONFIGURATION
# ============================================================

# Text Extraction and OCR
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARS=500000

# Identity Resolution and ACL
IDENTITY_CACHE_TTL=86400
ACL_INHERITANCE_CACHE_TTL=600
ACL_REVALIDATION_INTERVAL_SECONDS=900

# ============================================================
# BLOCK K: DOCUMENT READER CONFIGURATION
# ============================================================

# Storage backend: "mock" (for testing) | "minio" (for production)
STORAGE_BACKEND=mock
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=documents
STORAGE_SECURE=false

# Document size threshold for streaming (bytes, default 10MB)
STREAM_THRESHOLD_BYTES=10485760
STREAM_CHUNK_BYTES=8192

# ACL backend: "mock" | "http"
ACL_BACKEND=mock
ACL_SERVICE_URL=http://localhost:8000/acl

# ============================================================
# BLOCK L: ASSISTANT ORCHESTRATOR CONFIGURATION
# ============================================================

# Service URLs (all optional, defaults to localhost)
QUERY_FEDERATOR_URL=http://localhost:8000
GRAPH_SERVICE_URL=http://localhost:8000
DOCUMENT_READER_URL=http://localhost:8000
SIGNALS_URL=http://localhost:8000
