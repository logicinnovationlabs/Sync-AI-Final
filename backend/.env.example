# Control-plane database (stores tenant routing metadata only, never tenant data)
CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/control_plane

# Redis for session store and per-tenant cache
REDIS_URL=redis://redis:6379

# Vault configuration (blank = MockVaultClient for dev)
VAULT_URL=
VAULT_TENANT_ID=
VAULT_CLIENT_ID=
VAULT_CLIENT_SECRET=

# JWT configuration (RS256)
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=snyq-platform

# Token TTLs (seconds)
TOKEN_TTL_ACCESS=3600
TOKEN_TTL_REFRESH=604800

# Tenant cache configuration
TENANT_CACHE_TTL_SECONDS=1800

# OIDC/SSO configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# SCIM configuration
SCIM_ENDPOINT=
SCIM_TOKEN=

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# BLOCK B: CONNECTOR & INGESTION CONFIGURATION
# ============================================================

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# Embedding Configuration
EMBEDDING_PROVIDER=fake              # "gemini" in production, "fake" in tests/dev
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=

# Google Workspace OAuth (shared by all Google services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback

# Google Pub/Sub (for Gmail push notifications)
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-watch-notifications
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false       # Set to true in tests for synchronous execution

# Watch Channel Renewal (hours)
WATCH_RENEWAL_CHECK_HOURS=24
WATCH_RENEWAL_BEFORE_EXPIRY_HOURS=48

# ============================================================
# BLOCK C: NORMALIZATION, IDENTITY, AND ACL CONFIGURATION
# ============================================================

# Text Extraction and OCR
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARS=500000

# Identity Resolution and ACL
IDENTITY_CACHE_TTL=86400
ACL_INHERITANCE_CACHE_TTL=600
ACL_REVALIDATION_INTERVAL_SECONDS=900
