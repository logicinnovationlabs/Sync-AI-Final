@pytest.mark.asyncio
async def test_l_error_handling(l_app):
    """L: Verify proper error handling for invalid requests."""
    client = l_app
    
    token = make_bearer(TENANT_A, USER_ALICE)
    
    # Invalid request (missing required fields)
    resp = client.post(
        "/api/v1/assistant/chat",
        json={
            "query": "",  # Empty query
            "tenant_id": TENANT_A,
        },
        headers={"Authorization": f"Bearer {token}"},
    )
    
    # Should return 400 or 422 (validation error)
    assert resp.status_code in [400, 422]
