          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{job=~\"snyq-backend|otel-collector\", http_status_code=~\"4..\"}[5m])) by (http_route)",
          "legendFormat": "{{http_route}} 4xx",
          "refId": "B"
        }
      ],
      "title": "Error Rate (4xx + 5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
