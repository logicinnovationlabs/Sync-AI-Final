# Single unified backend (docker-compose.yml service `app`, host port 8000).
# Origin only — paths are /auth/login, /me, /connectors, etc. (no /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required for login on localhost (no tenant subdomain in the hostname).
# Seed script creates subdomain `alpha` (see backend/scripts/seed_tenants.py).
# Local Block N admin: admin@synq.dev / AlphaAdmin123!
# Local Block N member: member@alpha.test / AlphaMember123!
NEXT_PUBLIC_DEFAULT_TENANT=alpha

# Canonical origin for Open Graph URLs. Optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
